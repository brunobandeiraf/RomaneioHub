# =============================================================================
# ComprasHub - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comprashub

# -----------------------------------------------------------------------------
# AWS
# -----------------------------------------------------------------------------
# AWS region for all services (Cognito, S3, Secrets Manager)
AWS_REGION=us-east-1
# LocalStack endpoint for local development (leave empty in production)
AWS_ENDPOINT=http://localhost:4566
# S3 bucket for invoice file storage
S3_BUCKET=invoices-dev
# AWS Secrets Manager secret name
AWS_SECRET_NAME=compras-hub/development

# -----------------------------------------------------------------------------
# Cognito (Authentication)
# -----------------------------------------------------------------------------
# Cognito User Pool ID
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# Cognito App Client ID
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Stripe (Subscriptions & Billing)
# -----------------------------------------------------------------------------
# Stripe secret API key (use sk_test_ for development)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Stripe webhook endpoint signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Stripe Price ID for monthly subscription plan
STRIPE_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
# Stripe Price ID for annual subscription plan
STRIPE_ANNUAL_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Allowed CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:3000
# Frontend URL used for email links, redirects, etc.
FRONTEND_URL=http://localhost:3000
# Public API URL accessible from the browser
NEXT_PUBLIC_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Node environment: development | staging | production
NODE_ENV=development
# API server port
PORT=3001
