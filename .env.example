# =============================================================================
# RomaneioHub — Environment Variables
# =============================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env no repositório.
# =============================================================================

# Database
# URL de conexão PostgreSQL para o Prisma (obtida no Supabase Dashboard > Settings > Database)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.vwuxhbmpmlblmzmkujsu.supabase.co:5432/postgres

# Supabase
# URL do projeto (Supabase Dashboard > Settings > API)
SUPABASE_URL=https://vwuxhbmpmlblmzmkujsu.supabase.co
# Chave de serviço com privilégios admin — NUNCA exponha ao cliente
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Chave secreta JWT usada para verificar tokens emitidos pelo Supabase Auth
SUPABASE_JWT_SECRET=your-jwt-secret
# Chave pública anônima (pode ser exposta ao cliente)
SUPABASE_ANON_KEY=your-anon-key

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_SEMIANNUAL_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_ANNUAL_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx

# Frontend
# Origem permitida pelo CORS (URL do frontend em produção)
CORS_ORIGIN=http://localhost:3000
# URL do frontend usada em e-mails e redirects de autenticação
FRONTEND_URL=http://localhost:3000
# URL da API acessível pelo browser
NEXT_PUBLIC_API_URL=http://localhost:3001
# Variáveis públicas do Supabase para o Next.js (prefixo NEXT_PUBLIC_ é obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://vwuxhbmpmlblmzmkujsu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Application
NODE_ENV=development
PORT=3001
