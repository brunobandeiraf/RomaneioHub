# =============================================================================
# ComprasHub Web - Development Dockerfile
# =============================================================================
# Supports hot-reload via Next.js dev mode.
# =============================================================================

FROM node:20-alpine

WORKDIR /app

# Copy root package files for workspace resolution
COPY package.json package-lock.json turbo.json ./

# Copy workspace package.json files for dependency installation
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/db/package.json ./packages/db/
COPY packages/shared/package.json ./packages/shared/

# Install all dependencies
RUN npm ci

# Copy shared packages (needed for build/dev)
COPY packages/ ./packages/

# Copy web app source code
COPY apps/web/ ./apps/web/

EXPOSE 3000

# Start Next.js in development mode with hot-reload
CMD ["npm", "run", "dev", "--workspace=@compras-hub/web"]
